# Host services used by both the deployment connectivity check and backend.
DATABASE_URL=r2dbc:postgresql://postgres.onon1101.org:5432/lending_prod
DB_USER=lending_app
DB_PASSWORD=change-me

REDIS_URL=redis://redis.onon1101.org:6379

# RustFS S3 API. Create MINIO_BUCKET_NAME before deploying.
MINIO_ENDPOINT=http://rustfs.onon1101.org:9000
MINIO_ACCESS_KEY=replace-with-rustfs-access-key
MINIO_SECRET_KEY=replace-with-rustfs-secret-key
MINIO_BUCKET_NAME=lending-prod

JWT_SECRET=replace-with-at-least-32-random-bytes
AUDIT_HMAC_KEY=replace-with-a-long-random-secret
